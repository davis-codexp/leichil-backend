package templates

templ CheckoutSubscription(
    order_id string,
    api_key string,
    customer_name string,
    contact string,
    plan_name string,
    description string,
    auth_token string,
    amount int,
    duration string,
) {
    <main class="checkout-page">
        <input type="hidden" id="order_id" value={order_id} />
        <input type="hidden" id="api_key" value={api_key} />
        <input type="hidden" id="customer_name" value={customer_name} />
        <input type="hidden" id="contact" value={contact} />
        <input type="hidden" id="description" value={description} />
        <input type="hidden" id="amount" value={amount} />
        <input type="hidden" id="auth_token" value={auth_token} />
        <div class="checkout-container">
            <!-- HEADER -->
            <header class="checkout-header">
                <a href="https://leichiltv.com" class="checkout-back">
                    <svg viewBox="0 0 24 24" fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round">
                        <path d="M19 12H5"/>
                        <path d="m12 19-7-7 7-7"/>
                    </svg>
                    <span>Back to Leichil TV</span>
                </a>
                <h1>Subscribe to Leichil TV</h1>
                <p>Unlock unlimited entertainment with Leichil TV.</p>
            </header>
            <div class="subscription-checkout-grid">
                <!-- LEFT COLUMN -->
                <section class="checkout-main">
                    <div class="checkout-card">
                        <!-- PLAN HEADER -->
                        <div class="checkout-card-header">
                            <div>
                                <span class="checkout-label">YOUR SELECTED PLAN</span>
                                <h2>{ plan_name }</h2>
                            </div>
                            <span class="checkout-badge subscription-badge">
                                <svg viewBox="0 0 24 24" fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z"/>
                                </svg>
                                SUBSCRIPTION
                            </span>
                        </div>
                        <!-- PRICE -->
                        <div class="subscription-price-display">
                            <strong>₹{ amount/100 }</strong>
                            <span>/ { duration }</span>
                        </div>
                        <div class="checkout-divider"></div>
                        <!-- BENEFITS -->
                        <h2 class="subscription-features-heading">
                            Why Subscribe to Leichil TV?
                        </h2>
                        <!-- UNLIMITED MOVIES -->
                        <div class="subscription-feature">
                            <div class="subscription-feature-icon">
                                <svg viewBox="0 0 24 24" fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.7"
                                    stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <rect x="3" y="3" width="18" height="18" rx="3"/>
                                    <path d="m7 3 4 5-4 5"/>
                                    <path d="m15 3 4 5-4 5"/>
                                    <path d="M3 12h18"/>
                                </svg>
                            </div>
                            <div>
                                <h3>Wide Range of Movies & Shows</h3>
                                <p>Watch All Non-Premium Contents.</p>
                            </div>
                        </div>
                        <!-- OFFER -->
                        <div class="subscription-feature">
                            <div class="subscription-feature-icon">
                                <svg viewBox="0 0 24 24" fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.7"
                                    stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <rect x="3" y="8" width="18" height="13" rx="2"/>
                                    <path d="M12 8v13"/>
                                    <path d="M3 12h18"/>
                                    <path d="M12 8H7.5a2.5 2.5 0 1 1 2.5-2.5V8Z"/>
                                    <path d="M12 8h4.5A2.5 2.5 0 1 0 14 5.5V8Z"/>
                                </svg>
                            </div>
                            <div>
                                <h3>Offer</h3>
                                <p>
                                    Buy any Premium Content to enjoy
                                    1 month Basic Subscription absolutely FREE!
                                </p>
                            </div>
                        </div>
                        <!-- AD FREE -->
                        <div class="subscription-feature">
                            <div class="subscription-feature-icon">
                                <svg viewBox="0 0 24 24" fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.7"
                                    stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <rect x="2" y="3" width="20" height="14" rx="2"/>
                                    <path d="M8 21h8"/>
                                    <path d="M12 17v4"/>
                                    <path d="m9 8 6 5"/>
                                    <path d="m15 8-6 5"/>
                                </svg>
                            </div>
                            <div>
                                <h3>ADs Free</h3>
                                <p>
                                    Access Leichil TV contents without
                                    the annoying Ad interruptions.
                                </p>
                            </div>
                        </div>
                        <!-- HD STREAMING -->
                        <div class="subscription-feature">
                            <div class="subscription-feature-icon">
                                <svg viewBox="0 0 24 24" fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.7"
                                    stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <rect x="2" y="5" width="20" height="14" rx="2"/>
                                    <path d="M7 10v4"/>
                                    <path d="M10 10v4"/>
                                    <path d="M14 10h3"/>
                                    <path d="M14 14h3"/>
                                </svg>
                            </div>
                            <div>
                                <h3>HD Streaming</h3>
                                <p>Enjoy crystal-clear streaming quality.</p>
                            </div>
                        </div>
                        <div class="checkout-customer-details">
                            <div class="checkout-customer-item">
                                <div class="checkout-customer-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                        stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="8" r="4" />
                                        <path d="M5 21a7 7 0 0 1 14 0" />
                                    </svg>
                                </div>
                                <div>
                                    <span>Full Name</span>
                                    <strong>{ customer_name }</strong>
                                </div>
                            </div>
                            <div class="checkout-customer-item">
                                <div class="checkout-customer-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                        stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="5" y="2" width="14" height="20" rx="2" />
                                        <path d="M12 18h.01" />
                                    </svg>
                                </div>
                                <div>
                                    <span>Phone Number</span>
                                    <strong>{ contact }</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- RIGHT COLUMN -->
                <aside class="checkout-sidebar">
                    <div class="checkout-card">
                        <h2>Order Summary</h2>
                        <div class="subscription-order-plan">
                            <span>Selected Plan</span>
                            <strong>{ plan_name }</strong>
                        </div>
                        <div class="checkout-price-row">
                            <span>Duration</span>
                            <strong>{ duration }</strong>
                        </div>
                        <div class="checkout-price-row">
                            <span>Subscription Price</span>
                            <strong>₹{ amount/100 }</strong>
                        </div>
                        <div class="checkout-divider"></div>
                        <div class="checkout-total-row">
                            <span>Total Payable</span>
                            <strong>₹{ amount/100 }</strong>
                        </div>
                        <button type="button" id="pay-btn" class="checkout-pay-button">
                            Pay ₹{ amount/100 } Now
                            <svg viewBox="0 0 24 24" fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round">
                                <path d="M5 12h14"/>
                                <path d="m12 5 7 7-7 7"/>
                            </svg>
                        </button>
                        <div class="checkout-secure">
                            <svg viewBox="0 0 24 24" fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2"/>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                            </svg>
                            Secure payment powered by Razorpay
                        </div>
                    </div>
                </aside>
            </div>
            <footer class="checkout-footer">
                <p>© Leichil TV. All rights reserved.</p>
            </footer>
        </div>
    </main>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script>
        document.getElementById('pay-btn').onclick = function (e) {
            var options = {
                "key": document.getElementById("api_key").value,
                "amount": document.getElementById("amount").value,
                "currency": "INR",
                "name": "IRONBLADE INNOVATION LABS PRIVATE LIMITED",
                "description": document.getElementById("description").value,
                "order_id": document.getElementById("order_id").value,
                "handler": async function (response){
                    const token = document.getElementById("auth_token").value;
                    const payload = {
                        razorpay_order_id: response.razorpay_order_id,
                        razorpay_payment_id: response.razorpay_payment_id,
                        razorpay_signature: response.razorpay_signature 
                    };
                    const url = "http://127.0.0.1:9999/api/v1/app/orders/verify";
                    try {
                        const response = await fetch(url, {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "Authorization": token
                            },
                            body: JSON.stringify(payload)
                        });
                        if (!response.ok) {
                            console.log("Verification API Error");
                            window.location.replace("http://127.0.0.1:9999/payment-error");
                        } else {
                            const result = await response.json();
                            if (result?.success) window.location.replace("http://127.0.0.1:9999/payment-success");
                            else {
                                console.log(result);
                                window.location.replace("http://127.0.0.1:9999/payment-error");
                            }
                        }
                    } catch (err) {
                        console.error(err);
                        alert("Unable to verify payment");
                    }
                },
                "prefill": {
                    "name": document.getElementById("customer_name").value,
                    "contact": document.getElementById("contact").value
                },
                "theme": {
                    "color": "#3399cc"
                }
            };
            var rzp1 = new Razorpay(options);
            rzp1.open();
            e.preventDefault();
        }
    </script>
}
