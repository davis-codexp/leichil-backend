package templates

templ PaymentError() {
    <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Status</title>
    <style>
        .payment-error-container {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            max-width: 450px;
            margin: 40px auto;
            padding: 24px;
            border: 1px solid #f5c2c2;
            border-radius: 8px;
            background-color: #f8d7da;
            color: #721c24;
            text-align: center;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }
        .error-icon {
            font-size: 40px;
            margin-bottom: 12px;
        }
        .error-heading {
            font-size: 20px;
            font-weight: 600;
            margin: 0 0 8px 0;
        }
        .error-message {
            font-size: 15px;
            line-height: 1.5;
            margin: 0 0 20px 0;
            color: #58151c;
        }
        .retry-button {
            display: inline-block;
            background-color: #842029;
            color: #ffffff;
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            font-weight: 500;
            text-decoration: none;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }
        .retry-button:hover {
            background-color: #66181f;
        }
    </style>
</head>
<body>

    <div class="payment-error-container" role="alert">
        <div class="error-icon" aria-hidden="true">⚠️</div>
        <h2 class="error-heading">Payment Unsuccessful</h2>
        <p class="error-message">Unable to Process Payment at the moment. Please try again or use a different payment method.</p>
    </div>

</body>
</html>

}
