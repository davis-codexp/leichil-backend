templ Purchase(title string, itemType string, itemID string, price string, duration string) {
    <main class="purchase-page">
        <div class="purchase-container">
            <a href="/buy" class="buy-back-link">
                <span>←</span> Back to Store
            </a>
            <div class="purchase-heading">
                <span class="buy-eyebrow">LEICHIL TV CHECKOUT</span>
                <h1>Almost <span>There.</span></h1>
                <p>Enter your mobile number to continue with your purchase.</p>
            </div>
            <div class="purchase-grid">
                <section class="purchase-form-card">
                    <div class="purchase-step">
                        <span>01</span>
                        <div>
                            <h2>Your Mobile Number</h2>
                            <p>
                                We'll use this number to find or create
                                your Leichil TV account.
                            </p>
                        </div>
                    </div>
                    <form id="customer-lookup-form">
                        <label for="customer-mobile">Mobile Number</label>
                        <div class="purchase-mobile-input">
                            <span>+91</span>
                            <input
                                id="customer-mobile"
                                name="mobile"
                                type="tel"
                                inputmode="numeric"
                                maxlength="10"
                                placeholder="Enter 10-digit mobile number"
                                required />
                        </div>
                        <p class="purchase-input-hint">
                            Enter your 10-digit Indian mobile number.
                        </p>
                        <div
                            id="new-customer-fields"
                            class="new-customer-fields"
                            hidden>
                            <div class="purchase-step purchase-step-next">
                                <span>02</span>
                                <div>
                                    <h2>Create Your Account</h2>
                                    <p>
                                        We couldn't find an account with this number.
                                        Enter your name to continue.
                                    </p>
                                </div>
                            </div>

                            <label for="customer-name">Full Name</label>

                            <input
                                id="customer-name"
                                name="name"
                                type="text"
                                placeholder="Enter your full name"
                                autocomplete="name" />
                        </div>
                        <button class="purchase-continue" type="submit">
                            Continue <span>→</span>
                        </button>
                        <p
                            id="purchase-preview-message"
                            class="purchase-form-note"
                            hidden>
                        </p>
                        <p class="purchase-form-note">
                            Your account details will be used to manage
                            your Leichil TV purchases.
                        </p>
                    </form>
                </section>
                <aside class="purchase-summary">
                    <span class="buy-eyebrow">YOUR SELECTION</span>
                    <div class="purchase-summary-art">
                        if itemType == "subscription" {
                            <span>✦</span>
                        } else {
                            <span>▶</span>
                        }
                    </div>
                    <span class="purchase-type-label">
                        if itemType == "subscription" {
                            SUBSCRIPTION PLAN
                        } else {
                            PREMIUM CONTENT
                        }
                    </span>
                    <h2>{ title }</h2>
                    if itemType == "subscription" {
                        <p class="purchase-duration">{ duration }</p>
                    }
                    <div class="purchase-summary-price">₹{ price }</div>
                    <div class="purchase-summary-divider"></div>
                    <div class="purchase-summary-row">
                        <span>Item ID</span>
                        <strong>{ itemID }</strong>
                    </div>
                    <div class="purchase-summary-row">
                        <span>Payment</span>
                        <strong>Next step</strong>
                    </div>
                </aside>
            </div>
        </div>
    </main>
}
