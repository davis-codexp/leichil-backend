package pages

import (
	"leichil_tv_website/views/components"
	"leichil_tv_website/views/layouts"
)

templ Refund() {
	@layouts.Base("Refund & Cancellation Policy | Leichil TV") {

		@components.Navbar()

		<main class="privacy-page">

			<section class="privacy-hero">

				<div class="container">

					<div class="privacy-hero-content">

						<span class="privacy-badge">
							Refund & Cancellation Policy
						</span>

						<h1>Refund & Cancellation Policy</h1>

						<p>
							Please read our refund and cancellation policy
							before subscribing to Leichil TV services.
						</p>

						<div class="privacy-meta">

							<div class="meta-item">

								<span>Effective Date</span>

								<strong>4 Aug 2026</strong>

							</div>

							<div class="meta-item">

								<span>Last Updated</span>

								<strong>4 Aug 2026</strong>

							</div>

						</div>

					</div>

				</div>

			</section>

			<section class="privacy-section">

				<div class="container privacy-layout">

					<aside class="privacy-sidebar">

						<div class="sidebar-card">

							<h3>Contents</h3>

							<nav>

								<a href="#introduction">Introduction</a>

								<a href="#subscription">
									1. Subscription Cancellation Policy
								</a>

								<a href="#refund">
									2. Refund Policy
								</a>

								<a href="#contact">
									3. Contact Us
								</a>

							</nav>

						</div>

					</aside>

					<div class="privacy-content">

						<div
							class="privacy-card"
							id="introduction">

							<h2>Refund & Cancellation Policy</h2>

							<p>
								<strong>Effective Date:</strong> 4 Aug 2026
							</p>

							<p>
								<strong>Last Updated:</strong> 4 Aug 2026
							</p>

							<p>
								Thank you for subscribing to Leichil TV.
								This Refund and Cancellation Policy outlines
								the rules and guidelines governing
								cancellations, renewals and refunds for our
								streaming plans and digital content purchases.
							</p>

						</div>

						<div
							class="privacy-card"
							id="subscription">

							<h2>1. Subscription Cancellation Policy</h2>

							<p>
								You can cancel your Leichil TV subscription
								at any time through your account settings.
							</p>

							<h3>A. How to Cancel</h3>

							<ul>

								<li>
									<strong>Direct Web / In-App Subscriptions:</strong>
									Log in to your account,
									go to Settings &gt;
									Billing / Subscription,
									and select Cancel Subscription.
								</li>

							</ul>

							<h3>B. Access After Cancellation</h3>

							<ul>

								<li>
									Upon cancelling,
									your subscription will remain active
									until the end of your current billing cycle.
								</li>

								<li>
									You will retain full access
									to Leichil TV content for the remaining days
									of your prepaid period.
								</li>

								<li>
									Your subscription will not auto-renew
									at the start of the next billing cycle.
								</li>

								<li>
									Until your subscription is cancelled,
									you will be notified to renew
									your subscription.
								</li>

							</ul>

						</div>
                        						<div
							class="privacy-card"
							id="refund">

							<h2>2. Refund Policy</h2>

							<p>
								All payments made to Leichil TV are generally
								non-refundable, except as explicitly set forth
								in this policy or required by applicable law.
							</p>

							<h3>
								A. General Recurring Subscriptions
								(Monthly / Half yearly / Annual)
							</h3>

							<ul>

								<li>

									<strong>
										Partial Billing Periods:
									</strong>

									We do not provide prorated refunds
									or credits for unused days or unused
									viewing time within a billing cycle.

								</li>

								<li>

									<strong>
										Failure to Use the Service:
									</strong>

									Lack of app usage during an active
									subscription period does not qualify
									you for a refund.

								</li>

							</ul>

							<h3>
								B. Exceptions & Special Circumstances
							</h3>

							<p>
								We may grant refunds at our sole discretion
								under the following circumstances:
							</p>

							<ul>

								<li>

									<strong>
										Duplicate Charges:
									</strong>

									If a technical error results in
									double-billing for the same subscription
									period, we will refund the duplicate
									charge upon verification.

								</li>

								<li>

									<strong>
										Extended Service Outages:
									</strong>

									If a major technical failure on our
									platform prevents access to the Service for an extended uninterrupted period
									(e.g., more than [24/48 hours]),
									affected users may be eligible for
									a prorated credit or refund.

								</li>

							</ul>

							<h3>
								C. Pay-Per-View (PPV) and
								Transactional VOD (TVOD)
							</h3>

							<ul>

								<li>

									<strong>
										Final Sale:
									</strong>

									PPV and TVOD transactions are
									non-refundable once completed.

								</li>

								<li>

									<strong>
										Playback Errors:
									</strong>

									If a technical failure prevents you
									from completing your unwatched rental
									or event, please submit a request
									to support for a viewing time extension.

								</li>

								<li>

									<strong>
										Unwatched Content:
									</strong>

									There will be no refund even if you
									have not watched the content during
									the access window.

								</li>

							</ul>

						</div>

						<div
							class="privacy-card"
							id="contact">

							<h2>
								3. Contact Us for Refund Requests
							</h2>

							<p>
								If you believe you are eligible for
								a refund due to billing errors or
								extended service disruption,
								please contact our support team
								with your account details and
								payment receipt:
							</p>

							<ul>

								<li>

									<strong>
										Company Name:
									</strong>

									Iron Blade Labs Private Limited

								</li>

								<li>

									<strong>
										Support Email:
									</strong>

									contact@ironbladelabs.com

								</li>

								<li>

									<strong>
										Help Center:
									</strong>

									<a
										href="https://ironbladelabs.com"
										target="_blank"
										rel="noopener noreferrer">

										https://ironbladelabs.com

									</a>

								</li>

							</ul>

						</div>

					</div>

				</div>

			</section>

		</main>

		@components.Footer()

	}
}