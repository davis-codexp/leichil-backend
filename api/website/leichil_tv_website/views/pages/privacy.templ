package pages

import (
	"leichil_tv_website/views/components"
	"leichil_tv_website/views/layouts"
)

templ Privacy() {
	@layouts.Base("Privacy Policy | Leichil TV") {

		@components.Navbar()

		<main class="privacy-page">

			<section class="privacy-hero">

				<div class="container">

					<div class="privacy-hero-content">

						<span class="privacy-badge">
							Privacy Policy
						</span>

						<h1>Privacy Policy</h1>

						<p>
							Our commitment to protecting your privacy and
							keeping your personal information secure.
						</p>

						<div class="privacy-meta">

							<div class="meta-item">

								<span>Effective Date</span>

								<strong>4 Aug 2026</strong>

							</div>

							<div class="meta-item">

								<span>Last Updated</span>

								<strong>4 Aug 2026</strong>

							</div>

						</div>

					</div>

				</div>

			</section>

			<section class="privacy-section">

				<div class="container privacy-layout">

					<aside class="privacy-sidebar">

						<div class="sidebar-card">

							<h3>Contents</h3>

							<nav>

								<a href="#introduction">Introduction</a>

								<a href="#information">1. Information We Collect</a>

								<a href="#usage">2. How We Use Your Information</a>

								<a href="#sharing">3. How We Share Your Information</a>

								<a href="#rights">4. Your Rights & Choices</a>

								<a href="#security">5. Data Security & Retention</a>

								<a href="#transfer">7. International Data Transfers</a>

								<a href="#contact">8. Contact Us</a>

							</nav>

						</div>

					</aside>

					<div class="privacy-content">

						<div
							class="privacy-card"
							id="introduction">

							<h2>Privacy Policy</h2>

							<p>
								<strong>Effective Date:</strong> 4 Aug 2026
							</p>

							<p>
								<strong>Last Updated:</strong> 4 Aug 2026
							</p>

							<p>
								Ironblade Innovation Labs Pvt. Ltd. is committed to protecting your privacy. This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you use our OTT streaming service, website, mobile applications, smart TV applications, and related services (collectively, the "Service").
							</p>

						</div>

						<div
							class="privacy-card"
							id="information">

							<h2>1. Information We Collect</h2>

							<p>
								We collect several types of information from and about users of our Service:
							</p>

							<h3>A. Information You Provide Directly</h3>

							<ul>

								<li>
									<strong>Account Information:</strong>
									Name, email address, password,
									phone number, and birthdate/age verification.
								</li>

								<li>
									<strong>Subscription & Billing Data:</strong>
									Subscriber’s personal details and payment
									information collected securely through
									third party payment platforms
									(UPI, Credit/Debit card)
								</li>

								<li>
									<strong>User Profiles:</strong>
									Profile names, avatars,
									parental control settings,
									and viewing preferences
									created under your main account.
								</li>

								<li>
									<strong>Communications:</strong>
									Feedback, support requests,
									and surveys submitted to us.
								</li>

							</ul>

							<h3>B. Information Collected Automatically</h3>

							<ul>

								<li>
									<strong>Viewing & Playback Activity:</strong>
									Titles watched, watch time,
									pause/resume points, search queries,
									watchlist items, streaming quality,
									and buffering metrics.
								</li>

								<li>
									<strong>Device & Technical Data:</strong>
									IP address, unique device identifiers
									(IDFA, GAID, Smart TV IDs),
									hardware model, operating system,
									browser type, and app version.
								</li>

								<li>
									<strong>Location Data:</strong>
									Approximate location derived from your
									IP address to enforce regional content
									rights (geo-blocking) and deliver
									relevant content.
								</li>

								<li>
									<strong>Cookies & Tracking Technologies:</strong>
									Standard cookies, pixels, and SDKs
									to manage sessions, remember preferences,
									and analyze app performance.
								</li>

							</ul>

						</div>
                        						<div
							class="privacy-card"
							id="usage">

							<h2>2. How We Use Your Information</h2>

							<p>
								We use the collected information for the following purposes:
							</p>

							<ul>

								<li>
									<strong>Service Delivery:</strong>
									To stream content, manage your account,
									authenticate logins, and process payments.
								</li>

								<li>
									<strong>Personalization:</strong>
									To recommend movies, shows, and genres
									based on your watch history and preferences.
								</li>

								<li>
									<strong>Performance & DRM:</strong>
									To optimize playback quality,
									troubleshoot technical bugs,
									and protect copyrighted content via
									Digital Rights Management (DRM).
								</li>

								<li>
									<strong>Compliance & Licensing:</strong>
									To enforce territorial content rights
									and age restrictions.
								</li>

								<li>
									<strong>Communication:</strong>
									To send service notices,
									billing receipts,
									security alerts,
									and promotional offers
									(if opted-in)
								</li>

								<li>
									<strong>Advertising (if applicable):</strong>
									To serve targeted or non-targeted ads
									on free or ad-supported subscription tiers.
								</li>

							</ul>

						</div>

						<div
							class="privacy-card"
							id="sharing">

							<h2>3. How We Share Your Information</h2>

							<p>
								We do not sell your personal data.
								We share information only under
								the following conditions:
							</p>

							<ul>

								<li>
									<strong>Service Providers:</strong>
									Third-party vendors performing hosting,
									content delivery (CDNs),
									payment processing,
									customer support,
									and analytics.
								</li>

								<li>
									<strong>Content Partners & Rights Holders:</strong>
									Aggregated or anonymized viewing stats
									to report licensing royalties
									to content creators.
								</li>

								<li>
									<strong>Advertising Partners:</strong>
									If using an ad-supported model (AVOD),
									device identifiers and ad-engagement data
									may be shared with ad networks.
								</li>

								<li>
									<strong>Legal & Regulatory Requirements:</strong>
									When required by law,
									subpoena,
									or government order,
									or to protect the safety
									and rights of our users.
								</li>

								<li>
									<strong>Business Transfers:</strong>
									In connection with a merger,
									acquisition,
									or sale of company assets.
								</li>

							</ul>

						</div>

						<div
							class="privacy-card"
							id="rights">

							<h2>4. Your Rights & Choices</h2>

							<p>
								Depending on your jurisdiction
								(e.g., GDPR, CCPA/CPRA),
								you may have the following rights:
							</p>

							<ul>

								<li>
									<strong>Correction & Deletion:</strong>
									Request correction or deletion
									of your personal account data.
								</li>

								<li>
									<strong>Marketing Opt-Out:</strong>
									Unsubscribe from promotional emails
									via the link in the footer
									or app settings.
								</li>

								<li>
									<strong>Targeted Advertising:</strong>
									Opt out of personalized advertising
									through your device's privacy settings
									(e.g., "Limit Ad Tracking").
								</li>

								<li>
									<strong>Profile Management:</strong>
									Edit or remove user profiles
									and watch history
									within your account settings.
								</li>

							</ul>

						</div>

						<div
							class="privacy-card"
							id="security">

							<h2>5. Data Security & Retention</h2>

							<p>
								We implement administrative,
								technical,
								and physical safeguards
								(including encryption via TLS/HTTPS)
								to protect your personal information.
								We retain your data as long as
								your account is active
								or as necessary to comply with legal,
								accounting,
								or reporting obligations.
							</p>

						</div>

						<div
							class="privacy-card"
							id="transfer">

							<h2>7. International Data Transfers</h2>

							<p>
								Your information may be stored
								and processed in servers located
								outside your home country.
								By using our Service,
								you consent to the transfer
								of data to
								<strong>[New York/United States]</strong>
							</p>

						</div>

						<div
							class="privacy-card"
							id="contact">

							<h2>8. Contact Us</h2>

							<p>
								If you have questions,
								concerns,
								or requests regarding
								this Privacy Policy,
								please contact us at:
							</p>

							<ul>

								<li>
									<strong>Company Name:</strong>
									Ironblade Innovation Labs Private Limited
								</li>

								<li>
									<strong>Email:</strong>
									contact@ironbladelabs.com
								</li>

								<li>
									<strong>Address:</strong>
									Nahabam, Bamon Leikai
								</li>

							</ul>

						</div>

					</div>

				</div>

			</section>

		</main>

		@components.Footer()

	}
}