								<a href="#account">
									1. Account Eligibility & Registration
								</a>

								<a href="#subscription">
									2. Subscriptions, Billing & Renewal
								</a>

								<a href="#license">
									3. License & Content Usage Rules
								</a>

								<a href="#ip">
									4. Intellectual Property Rights
								</a>

								<a href="#quality">
									5. Service Quality & Updates
								</a>

								<a href="#liability">
									6. Limitation of Liability
								</a>

								<a href="#termination">
									7. Account Termination
								</a>

								<a href="#law">
									8. Governing Law
								</a>

								<a href="#changes">
									9. Changes to Terms
								</a>

								<a href="#contact">
									10. Contact Us
								</a>

							</nav>

						</div>

					</aside>

					<div class="privacy-content">

						<div
