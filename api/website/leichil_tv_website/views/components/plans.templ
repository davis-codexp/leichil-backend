package components

templ Plans() {
	<section class="plans" id="plans">

		<div class="container">

			<div class="section-header">

				<h1>Subscription Plans</h1>

				<h2 class="margin">
					Simple Pricing,
					Premium Entertainment
				</h2>

				<p>
					Choose the plan that works best for you. Subscribe securely
					through the Leichil TV mobile app and enjoy unlimited access
					to premium Manipuri movies, series and dramas.
				</p>

			</div>

			<div class="plans-grid">

				<!-- Monthly -->

				<article class="plan-card">

					<h3 class="plan-title">
						Basic Subscription
					</h3>

					<div class="plan-price">

						<span class="currency">₹</span>

						<span class="amount">49</span>

					</div>

					<p class="plan-duration">
						per month
					</p>

					<ul class="plan-features">

						<li>✓ Unlimited Streaming</li>

						<li>✓ Full HD Quality</li>

						<li>✓ Watch on Mobile & TV</li>

						<li>✓ Regular Content Updates</li>

						<li>✓ Premium Content Not Included</li>

					</ul>

					<a
						href="#download"
						class="plan-button">

						Subscribe in App

					</a>

				</article>

				<!-- 6 Months -->

				<article class="plan-card popular">

					<h3 class="plan-title">
						 Premium Contents
					</h3>

					<div class="plan-price">

						<span class="currency">Starts at ₹</span>

						<span class="amount">69 </span>

					</div>

					<p class="plan-duration">
						Minimum 6 months access
					</p>

					<ul class="plan-features">

						<li>✓ 1 Month Free Access to Basic Subscription</li>

						<li>✓ Unlimited Streaming</li>

						<li>✓ Full HD Quality</li>

						<li>✓ Watch on Mobile & TV</li>

						<li>✓ Priority Support</li>

					</ul>

					<a
						href="#download"
						class="plan-button">

						Subscribe in App

					</a>

				</article>

				<!-- Yearly -->

				// <article class="plan-card">

				// 	<h3 class="plan-title">
				// 		Yearly
				// 	</h3>

				// 	<div class="plan-price">

				// 		<span class="currency">₹</span>

				// 		<span class="amount">1299</span>

				// 	</div>

				// 	<p class="plan-duration">
				// 		per year
				// 	</p>

				// 	<ul class="plan-features">

				// 		<li>✓ Unlimited Streaming</li>

				// 		<li>✓ Full HD Quality</li>

				// 		<li>✓ Android Phone & TV</li>

				// 		<li>✓ Exclusive Premieres</li>

				// 		<li>✓ Best Savings</li>

				// 	</ul>

				// 	<a
				// 		href="#download"
				// 		class="plan-button">

				// 		Subscribe in App

				// 	</a>

				// </article>

			</div>

		</div>

	</section>
}