package components

templ Download() {
<section class="download-section" id="download">

    <div class="container">

        <div class="download-box">

            <div class="section-header">

                <h1>Download the App</h1>

                <h2 class="margin">
                    Start Watching Today
                </h2>

                <p>
                    Download Leichil TV and enjoy the best Manipuri movies,
                    series and dramas anytime, anywhere. Subscription and
                    payment are available exclusively inside the mobile app.
                </p>

            </div>

            <div class="store-buttons">

                <a href="https://play.google.com/store/apps/details?id=com.leichiltv.leichil_tv&pcampaignid=web_share" target="_blank" rel="noopener noreferrer" class="store-badge">

                    <img src="/static/images/stores/google_play.svg" alt="Get it on Google Play" />

                </a>

                <a href="javascript:void(0)" class="store-badge disabled" aria-disabled="true">

                    <img src="/static/images/stores/app_store.svg" alt="Download on the App Store" />

                </a>

            </div>

            <div class="supported-devices">

                <h3>Available On</h3>

                <div class="device-list">

                    <span class="device-pill">Android Phones</span>

                    <span class="device-pill">Android Tablets</span>

                </div>

            </div>

            <p class="download-note">
                *iOS and Android TV version coming soon.
            </p>

        </div>

    </div>

</section>
}