package components

templ Navbar() {
	<header class="navbar">

		<div class="container navbar-container">

			<a href="/" class="brand" aria-label="Leichil TV">

				<img
					class="brand-logo"
					src="/static/images/logo/leichil_logo.png"
					alt="Leichil TV Logo"
				/>

				<img
					class="brand-text"
					src="/static/images/logo/leichil_logo_text.png"
					alt="Leichil TV"
				/>

			</a>

			<nav class="navbar-nav">

				<a href="#plans">Plans</a>

				<a href="#features">Features</a>

			</nav>

			<a
				href="#download"
				class="btn btn-primary desktop-btn">

				Download App

			</a>

		</div>

	</header>
}