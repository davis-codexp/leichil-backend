package components

templ Hero() {
<section class="hero" id="home">

    <div class="hero-background">

        <div class="hero-grid"></div>

        <div class="aurora aurora-1"></div>
        <div class="aurora aurora-2"></div>
        <div class="aurora aurora-3"></div>

        <div id="particles"></div>

    </div>

    <div class="container hero-container">

        <div class="hero-content">

            <div class="hero-tag">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                    <path d="M4 5h16v14H4z" />
                    <path d="M4 9h16" />
                    <path d="M8 5l2 4" />
                    <path d="M14 5l2 4" />

                </svg>
                The Home of Manipuri Entertainment
            </div>

            // <h1>
                // Watch the Best
                // <br />
                // Manipuri Movies,
                // <br />
                // Series & Dramas
                // </h1>

            <h1>
                Watch the Best
                <br />
                Manipuri Movies,
                <br />
                <span class="hero-highlight">Series & Dramas</span>
            </h1>

            <p>
                Stream premium Manipuri entertainment anytime, anywhere.
                Discover timeless classics, exclusive originals and the latest
                releases in one beautifully designed app.
            </p>

            <div class="hero-actions">

                <a href="https://play.google.com/store/apps/details?id=com.leichiltv.leichil_tv&pcampaignid=web_share"
                    target="_blank" rel="noopener noreferrer" class="store-badge">

                    <img src="/static/images/stores/google_play.svg" alt="Get it on Google Play" />

                </a>

                <a href="javascript:void(0)" class="store-badge disabled" aria-disabled="true">

                    <img src="/static/images/stores/app_store.svg" alt="Download on the App Store" />

                </a>

            </div>

        </div>

    </div>

</section>
}