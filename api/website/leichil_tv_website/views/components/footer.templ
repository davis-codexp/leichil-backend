package components

templ Footer() {
<footer class="footer">
<div class="container">
<div class="footer-content">
<div class="footer-brand">
<a href="/" class="footer-logo">
<img
 						src="/static/images/logo/leichil_logo.png"
 						alt="Leichil TV Logo"
 						class="brand-logo"
 					/>
<img
 						src="/static/images/logo/leichil_logo_text.png"
 						alt="Leichil TV"
 						class="brand-text"
 					/>
</a>

				<p>
					Leichil TV is your destination for premium Manipuri
					movies, series and dramas. Stream quality entertainment
					anytime, anywhere.
				</p>
			</div>

			<div class="footer-links">
				<div class="footer-column">
					<h4>Support</h4>
					<ul>
						<li>
							<a href="/privacy-policy">Privacy Policy</a>
						</li>
						<li>
							<a href="/refund-policy">Refund & Cancellations</a>
						</li>
						<li>
							<a href="/terms-and-conditions">Terms & Conditions</a>
						</li>
					</ul>
				</div>
			</div>
		</div>

		<div class="footer-bottom">
			<p>© 2026 Leichil TV. All Rights Reserved.</p>
		</div>
	</div>
</footer>

}